# ============================================================================
# Heavenly Dao Engine · environment configuration
#
# HOW TO USE
#   1. Copy this file to `.env`
#        Windows:  copy .env.example .env
#        macOS/Linux:  cp .env.example .env
#   2. Fill in your Discord bot token — the ONLY required value
#   3. Optionally set DEV_GUILD_ID for instant slash-command sync while testing
#   4. Start the bot:  python run.py
#
# NOTE: game-balance tuning constants are NOT environment variables. They live
# in `config/default.py` (cooldowns, caps, Groq limits) and `core/math.py`
# (Qi curves, difficulty, erasure odds). Edit those files to tweak numbers.
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------
# Discord bot token.
#   1. Create an application at https://discord.com/developers/applications
#   2. Bot > Build-A-Bot > create the bot, then copy its token
#   3. Bot > Privileged Gateway Intents > enable MESSAGE CONTENT INTENT
#      (required for passive Qi from chat)
#   4. OAuth2 > URL Generator > scopes: `bot` + `applications.commands`,
#      then invite the bot to your server
DISCORD_TOKEN=your_bot_token_here

# --- Optional: Discord ------------------------------------------------------
# Set to your server's numeric ID to sync slash commands INSTANTLY (ideal while
# testing). Leave empty to sync globally — this can take up to ~1 hour to
# propagate to Discord. Enable Developer Mode in Discord, right-click your
# server, and choose "Copy Server ID" to find the number.
DEV_GUILD_ID=

# --- Storage & Database -----------------------------------------------------
# Database engine: `sqlite` (default, zero-cost) or `postgres` (enterprise pool)
DATABASE_TYPE=sqlite

# SQLite database file. Relative paths resolve against the project root.
DATABASE_PATH=heavenly_dao.db

# PostgreSQL Connection String (used when DATABASE_TYPE=postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/heavenly_dao
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=20

# Daily auto-backups are written here (one snapshot per day, kept indefinitely).
# See `db/database.py::backup_database`.
BACKUP_DIR=backups

# --- Groq free-tier LLM (OPTIONAL — DISABLED BY DEFAULT) --------------------
# The bot is 100% playable with no AI API at all — all narrative comes from
# the template engine. Leave these blank to keep the $0 budget.
#
# When enabled, Groq is used ONLY for Tier-4 narrative moments (Heart Demon
# trials, companion first meetings, world-event climaxes) and every failure
# automatically falls back to the template engine.
#
# Get a free (rate-limited) key at https://console.groq.com/keys
GROQ_API_KEY=

# Set to "true" to enable Groq. Defaults to "false".
ENABLE_GROQ=false

# Fixed rate limits for the free tier (also in config/default.py):
#   * 1 live call per player per 24 hours
#   * max 10 calls per hour across all players
#   * max 100 calls per day across all players

# --- Off-server GitHub backup mirror (OPTIONAL but RECOMMENDED) ---------------
# Every daily snapshot in BACKUP_DIR is also pushed to a dedicated branch in a
# GitHub repo, so a hosting-provider purge (e.g. wispbyte's 14-day inactivity
# rule) can never permanently destroy player data. Best-effort: if these are
# empty, the bot simply logs "mirror skipped".
#
# SECURITY: the database contains player data — use a PRIVATE repository.
#
#   1. Create a private repo (e.g. heavenly-dao-backups)
#   2. Generate a token: github.com > Settings > Developer settings >
#      Personal access tokens > Fine-grained tokens > "Contents: Read and
#      write" on that repo only
#   3. Paste the token here (kept only in .env — never committed)
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=yourname/heavenly-dao-backups
GITHUB_BACKUP_BRANCH=db-backups
GITHUB_BACKUP_KEEP=14   # number of snapshots to keep on the branch
